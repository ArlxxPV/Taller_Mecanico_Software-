# Copia este archivo como "application-secrets.yml" en esta misma carpeta
# (backend/src/main/resources/) y pon ahi tus valores reales.
# application-secrets.yml esta en .gitignore: nunca se sube a GitHub.

spring:
  datasource:
    username: tu_usuario_mysql
    password: tu_password_mysql

tallerpro:
  jwt:
    # Genera una clave nueva y aleatoria, minimo 32 caracteres.
    # Por ejemplo con: openssl rand -base64 48
    secret: "reemplaza-esto-por-una-clave-aleatoria-de-al-menos-32-caracteres"
